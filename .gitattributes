# Insumos pesados o binarios: Git LFS (ver docs/insumos_versionado.md).
# Hoy estas rutas siguen en .gitignore; al decidir versionarlas, quitar las lineas del .gitignore y hacer
# `git lfs install && git lfs track` ya queda cubierto por estos patrones.
models/runtime/*.pkl filter=lfs diff=lfs merge=lfs -text
models/backups/** filter=lfs diff=lfs merge=lfs -text
data/raw/digemid/*.csv filter=lfs diff=lfs merge=lfs -text
data/raw/pharmacies/*.csv filter=lfs diff=lfs merge=lfs -text
data/training/supplement_model/*.csv filter=lfs diff=lfs merge=lfs -text
data/raw/nhanes/**/*.XPT filter=lfs diff=lfs merge=lfs -text
*.csv text eol=lf
*.py text eol=lf
