APP_NAME=SupleMatch API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
DATABASE_URL=postgresql+psycopg://suplematch:suplematch@localhost:5432/suplematch
DB_ECHO=false
JWT_SECRET_KEY=change-me-local-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Solo para demo/local. Debe ser false en staging/prod porque el token debe enviarse por email.
PASSWORD_RESET_RETURN_TOKEN=false
PUBLIC_FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional external OpenAI integration tests.
# These tests consume real API quota and are skipped unless explicitly enabled.
RUN_OPENAI_INTEGRATION_TESTS=0
OPENAI_API_KEY=
OPENAI_TEST_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional seed users. Required only when bootstrapping staging/prod admin users.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=SupleMatch Admin
MODERATOR_EMAIL=
MODERATOR_PASSWORD=
MODERATOR_DISPLAY_NAME=SupleMatch Moderator

# Model artifacts used by app/ml/runtime/pipeline_completo.py and modelo2_inference.py
MODEL_DIR=app/ml/runtime

# Legacy fallback used only by old runtime/tests that import app/ml/runtime/feedback_store.py directly.
# API recommendation/feedback persistence is relational and uses DATABASE_URL.
FEEDBACK_DB_PATH=app/ml/runtime/feedback.sqlite3

# DIGEMID/component/product catalog paths
DIGEMID_CSV_PATH=digemid_limpio.csv
PRODUCT_COMPONENTS_CSV_PATH=product_components.csv
APPROVED_CATALOG_PATH=data/catalog/approved_catalog.csv
