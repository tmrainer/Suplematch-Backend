APP_NAME=SupleMatch API
APP_VERSION=0.1.0
CORS_ORIGINS=["*"]
DATABASE_URL=postgresql+psycopg://suplematch:suplematch@localhost:5432/suplematch
DB_ECHO=false
JWT_SECRET_KEY=change-me-local-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Model artifacts used by app/ml/runtime/pipeline_completo.py and modelo2_inference.py
MODEL_DIR=app/ml/runtime

# Legacy fallback used only by old runtime/tests that import app/ml/runtime/feedback_store.py directly.
# API recommendation/feedback persistence is relational and uses DATABASE_URL.
FEEDBACK_DB_PATH=app/ml/runtime/feedback.sqlite3

# DIGEMID/component/product catalog paths
DIGEMID_CSV_PATH=digemid_limpio.csv
PRODUCT_COMPONENTS_CSV_PATH=product_components.csv
APPROVED_CATALOG_PATH=data/catalog/approved_catalog.csv
